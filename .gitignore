# =========================================================
# SkillTrack - Full Stack .gitignore
# =========================================================


# =========================================================
# .NET / ASP.NET Core
# =========================================================

# Build output
**/[Bb]in/
**/[Oo]bj/
**/[Dd]ebug/
**/[Rr]elease/
**/[Aa]rtifacts/

# Visual Studio
.vs/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Visual Studio generated files
Generated\ Files/
*.pdb
*.ilk
*.obj
*.idb
*.iobj
*.pch
*.ipdb
*.pgc
*.pgd
*.rsp
*.tlog
*.log

# .NET / NuGet
packages/
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# Test results / coverage
[Tt]est[Rr]esult*/
*.trx
coverage/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# ASP.NET / publishing
publish/
*.pubxml
*.publishproj
PublishScripts/

# Scaffolding
ScaffoldingReadMe.txt

# Local .NET settings
backend/**/appsettings.Development.json
backend/**/appsettings.Local.json


# =========================================================
# Angular / Node.js / Frontend
# =========================================================

# Dependencies
node_modules/
frontend/node_modules/

# Angular build output
frontend/dist/
frontend/.angular/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Angular environment files
frontend/.env
frontend/.env.local
frontend/.env.*.local

# General environment files
*.env
*.env.local
.env
.env.local

# Angular cache
.angular/


# =========================================================
# Database
# =========================================================

# SQL Server database files
*.mdf
*.ldf
*.ndf

# Database backups
*.bak

# SQL Server temporary files
*.dbmdl

# Local database files
database/*.mdf
database/*.ldf
database/*.ndf
database/*.bak


# =========================================================
# Secrets / Credentials
# =========================================================

# Secret configuration files
**/secrets.json

# Local configuration
**/appsettings.Local.json

# Certificates / private keys
*.pfx
*.publishsettings


# =========================================================
# IDEs / Editors
# =========================================================

# Visual Studio Code
.vscode/

# JetBrains Rider / IntelliJ
.idea/

# VS Code history
.history/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user


# =========================================================
# Operating System
# =========================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~


# =========================================================
# Temporary / Backup Files
# =========================================================

*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo

# Backup files
*~
~$*


# =========================================================
# Logs
# =========================================================

*.log
logs/
Log/
Logs/


# =========================================================
# Miscellaneous Build / Tool Files
# =========================================================

# MSBuild logs
*.binlog
MSBuild_Logs/

# Benchmark results
BenchmarkDotNet.Artifacts/

# Code coverage tools
OpenCover/
.coverage/

# Fody
FodyWeavers.xsd

# Azure / deployment temporary files
*.azurePubxml

# Temporary backup folder
backend-old/